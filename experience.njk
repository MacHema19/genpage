---
layout: layouts/base.njk
permalink: experience.html
pageKey: experience
title: Professional Experience
metaDescription: Leadership experience across deployment governance, quality engineering, cybersecurity, IT operations and major incident management.
---
{# Executive experience timeline using verified role information. #}
{% from "components/icons.njk" import icon %}
<section class="experience-page section">
  <div class="container experience-layout">
    <header class="experience-intro">
      <p class="eyebrow">Executive Career</p>
      <h1>Professional Experience</h1>
      <p>A track record of leading high-impact technology initiatives, building resilient teams, and delivering measurable value.</p>
    </header>
    <div class="timeline">
      {% for role in experience %}
      <article class="experience-item" data-reveal>
        <div class="experience-item__marker" aria-hidden="true"></div>
        {% if role.dates %}<p class="experience-item__date">{{ icon('calendar') }}<span>{{ role.dates }}</span></p>{% endif %}
        <div class="experience-item__card">
          <div class="experience-item__monogram" aria-hidden="true">{{ role.initials }}</div>
          <div class="experience-item__body">
            <h2>{{ role.title }}</h2>
            <p class="experience-item__company">{{ role.company }}</p>
            <p class="experience-item__context">{{ role.context }}</p>
            <p>{{ role.summary }}</p>
            <div class="tag-list">{% for tag in role.tags %}<span>{{ tag }}</span>{% endfor %}</div>
            <details>
              <summary><span>View achievements</span></summary>
              <ul>{% for achievement in role.achievements %}<li>{{ achievement }}</li>{% endfor %}</ul>
            </details>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
