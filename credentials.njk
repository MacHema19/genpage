{# Education and professional development page. #}
<section class="section"><div class="container"><div class="section-heading"><h2>Education</h2></div><div class="education-grid">{% for item in credentials.education %}<article class="education-card" data-reveal><span class="education-card__year">{{ item.year }}</span><h3>{{ item.qualification }}</h3><p>{{ item.institution }}</p><strong>{{ item.field }}</strong></article>{% endfor %}</div><div class="section-heading credentials-heading"><h2>Professional Certifications</h2></div><div class="certification-grid">{% for item in credentials.certifications %}<article class="certification-card" data-reveal><span>{{ item.status }}</span><h3>{{ item.name }}</h3><p>{{ item.issuer }}</p>{% if item.year %}<time>{{ item.year }}</time>{% endif %}{% if item.credentialUrl %}<a href="{{ item.credentialUrl }}" target="_blank" rel="noopener noreferrer">View credential</a>{% endif %}</article>{% endfor %}</div></div></section>
