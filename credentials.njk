---
layout: layouts/base.njk
permalink: credentials.html
pageKey: credentials
title: Education & Credentials
metaDescription: Verified education and professional development for technology executive Hema Darshini Selvaraju.
---
{# Verified executive education, competencies and professional development. #}
{% from "components/icons.njk" import icon %}
{% set competencies = [
  { title: "Technology Strategy", icon: "network" },
  { title: "Cloud & Infrastructure", icon: "cloud" },
  { title: "Cybersecurity", icon: "shield" },
  { title: "IT Governance & Risk", icon: "scale" },
  { title: "Enterprise Architecture", icon: "building" },
  { title: "Service Management", icon: "operate" }
] %}
<section class="credentials-hero">
  <div class="container credentials-hero__grid">
    <div class="credentials-hero__copy">
      <p class="eyebrow">Credentials</p>
      <h1>Education &amp; Credentials</h1>
      <p>A strong foundation of academic excellence and industry-recognised credentials supporting strategic leadership and digital transformation.</p>
    </div>
    <div class="credentials-hero__portrait" aria-hidden="true"><img src="{{ site.portrait }}" alt="" width="1122" height="1402"></div>
  </div>
</section>
<section class="credentials-content section">
  <div class="container">
    <section aria-labelledby="competencies-title">
      <div class="credentials-section-title"><h2 id="competencies-title">Core Competencies</h2></div>
      <div class="competency-grid">{% for item in competencies %}<div class="competency-pill">{{ icon(item.icon) }}<span>{{ item.title }}</span></div>{% endfor %}</div>
    </section>
    <div class="credentials-columns">
      <section aria-labelledby="education-title">
        <div class="credentials-section-title">{{ icon('education') }}<h2 id="education-title">Education</h2></div>
        <div class="education-timeline">
          {% for item in credentials.education %}<article class="education-card" data-reveal><div class="education-card__icon">{{ icon('education') }}</div><div><h3>{{ item.qualification }}</h3><strong>{{ item.field }}</strong><p>{{ item.institution }}</p><span class="education-card__date">{{ icon('calendar') }} {{ item.year }}</span></div></article>{% endfor %}
        </div>
      </section>
      <section aria-labelledby="certifications-title">
        <div class="credentials-section-title">{{ icon('award') }}<h2 id="certifications-title">Professional Certifications</h2></div>
        <div class="certification-grid">
          {% for item in credentials.certifications %}<article class="certification-card" data-reveal><div class="certification-card__icon">{{ icon('award') }}</div><h3>{{ item.name }}</h3><strong>{{ item.status }}</strong><p>{{ item.issuer }}</p>{% if item.year %}<time>{{ item.year }}</time>{% endif %}{% if item.credentialUrl %}<a href="{{ item.credentialUrl }}" target="_blank" rel="noopener noreferrer">View credential</a>{% endif %}</article>{% endfor %}
        </div>
      </section>
    </div>
  </div>
</section>
