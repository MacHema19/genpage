---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
{# XML sitemap generated from public Eleventy pages. #}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}{% if item.url and item.url != '/404.html' %}<url><loc>{{ site.siteUrl }}{{ item.url }}</loc>{% if item.date %}<lastmod>{{ item.date | htmlDateString }}</lastmod>{% endif %}</url>{% endif %}{% endfor %}
</urlset>
