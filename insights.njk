---
layout: layouts/page.njk
permalink: insights.html
pageKey: insights
title: Latest Insights
eyebrow: Insights & Perspectives
intro: Thoughts on leadership, technology and transformation—shared to drive clarity and impact.
metaDescription: Articles on technology governance, cloud transformation, delivery risk and enterprise operational resilience.
---
{# Automatically generated listing of published Markdown articles. #}
{% from "components/icons.njk" import icon %}
<section class="section insights-listing">
  <div class="container">
    <div class="insights-status">{{ icon('github') }}<span>Managed in Markdown / Synced from GitHub</span><i aria-hidden="true"></i></div>
    <div class="article-grid">
      {% for post in collections.publishedPosts %}
      <a class="article-card" href="{{ post.url }}" data-reveal>
        <img src="{{ post.data.coverImage }}" alt="" width="600" height="338" loading="lazy">
        <div class="article-card__body">
          <span class="article-card__category">{{ post.data.category }}</span>
          <h2>{{ post.data.title }}</h2>
          <p>{{ post.data.summary }}</p>
          <div class="article-card__meta">
            <span>{{ icon('calendar') }}<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></span>
            <span>{{ icon('clock') }}{{ post.data.readTime or (post.content | readingTime) }}</span>
          </div>
          <span class="article-card__action">Read article {{ icon('arrow') }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
