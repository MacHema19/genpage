---
{# Executive case studies page with verified-only metric rendering. #}
{% from "components/icons.njk" import icon %}
<section class="section"><div class="container case-study-list">{% for study in caseStudies %}<article class="case-study" data-reveal><div class="icon-frame">{{ icon(study.icon) }}</div><div class="case-study__content"><h2>{{ study.title }}</h2><h3>Challenge</h3><p>{{ study.challenge }}</p><details><summary>View executive actions and outcome</summary><h3>Executive actions</h3><ul>{% for action in study.actions %}<li>{{ action }}</li>{% endfor %}</ul><h3>Outcome</h3><p>{{ study.outcome }}</p>{% set verifiedMetrics = study.metrics | selectattr('verified') %}{% if verifiedMetrics %}<div class="case-metrics">{% for metric in verifiedMetrics %}<div><strong>{{ metric.value }}</strong><span>{{ metric.label }}</span></div>{% endfor %}</div>{% endif %}</details></div></article>{% endfor %}</div></section>
