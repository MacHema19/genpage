---
layout: layouts/page.njk
permalink: case-studies.html
pageKey: case-studies
title: Selected Case Studies
eyebrow: Enterprise Impact
intro: Real challenges. Strategic leadership. Measurable impact.
metaDescription: Executive case studies covering deployment governance, QA automation, quality engineering and operational resilience.
---
{# Executive case studies using verified qualitative outcomes only. #}
{% from "components/icons.njk" import icon %}
<section class="section case-studies-section">
  <div class="container">
    <div class="case-study-list">
      {% for study in caseStudies %}
      <article class="case-study" id="case-study-{{ loop.index }}" data-reveal>
        <div class="case-study__heading">
          <div class="icon-frame">{{ icon(study.icon) }}</div>
          <h2>{{ study.title }}</h2>
        </div>
        <p class="case-study__summary">{{ study.summary }}</p>
        <ul class="case-study__outcomes" aria-label="Key outcomes">
          {% for item in study.outcomes %}<li>{{ icon('shield') }}<span>{{ item }}</span></li>{% endfor %}
        </ul>
        <details>
          <summary><span>View Case Study</span>{{ icon('arrow') }}</summary>
          <div class="case-study__details">
            <h3>Challenge</h3><p>{{ study.challenge }}</p>
            <h3>Executive actions</h3><ul>{% for action in study.actions %}<li>{{ action }}</li>{% endfor %}</ul>
            <h3>Outcome</h3><p>{{ study.outcome }}</p>
          </div>
        </details>
      </article>
      {% endfor %}
    </div>
    <aside class="case-studies-cta">
      <div class="icon-frame">{{ icon('users') }}</div>
      <div><h2>Interested in how I can help drive transformation in your organisation?</h2><p>Let’s discuss opportunities to collaborate and create impact.</p></div>
      <a class="button button--primary" href="/contact.html">Let’s Connect</a>
    </aside>
  </div>
</section>
