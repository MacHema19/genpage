{# Base HTML document shared across every generated page. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ metaTitle or title }}</title>
  <meta name="description" content="{{ metaDescription or site.description }}">
  <meta name="theme-color" content="#fbfaf7">
  <link rel="canonical" href="{{ site.siteUrl }}{{ page.url }}">
  <meta property="og:title" content="{{ metaTitle or title }} | {{ site.name }}">
  <meta property="og:description" content="{{ metaDescription or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.siteUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ site.siteUrl }}{{ coverImage or site.defaultImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle or title }} | {{ site.name }}">
  <meta name="twitter:description" content="{{ metaDescription or site.description }}">
  <meta name="twitter:image" content="{{ site.siteUrl }}{{ coverImage or site.defaultImage }}">
  <link rel="icon" href="/assets/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Franklin:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <script type="application/ld+json">{{ {"@context":"https://schema.org","@type":"WebSite","name":"Hema Darshini Selvaraju Executive Portfolio","url":site.siteUrl} | json | safe }}</script>
  {% if schema %}<script type="application/ld+json">{{ schema | json | safe }}</script>{% endif %}
  {% if page.url != '/' %}<script type="application/ld+json">{{ {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Overview","item":site.siteUrl + "/"},{"@type":"ListItem","position":2,"name":title,"item":site.siteUrl + page.url}]} | json | safe }}</script>{% endif %}
</head>
<body data-page="{{ pageKey }}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  {% include "components/header.njk" %}
  <main id="main-content">{{ content | safe }}</main>
  {% include "components/footer.njk" %}
  <script type="module" src="/js/app.js"></script>
</body>
</html>
