---
layout: layouts/base.njk
ogType: article
pageKey: insights
eleventyComputed:
  metaTitle: "{{ title }}"
  metaDescription: "{{ summary }}"
  schema:
    "@context": "https://schema.org"
    "@type": "Article"
    headline: "{{ title }}"
    description: "{{ summary }}"
    datePublished: "{{ date | htmlDateString }}"
    author:
      "@type": "Person"
      name: "{{ site.name }}"
    image: "{{ site.siteUrl }}{{ coverImage }}"
    mainEntityOfPage: "{{ site.siteUrl }}{{ page.url }}"
---
{# Markdown article layout with navigation, related content and Article schema. #}
{% from "components/icons.njk" import icon %}
<article class="article">
  <div class="container">
    <a class="back-link" href="/insights.html">← Back to Insights</a>
    <header class="article__header">
      <p class="eyebrow">{{ category }}</p>
      <h1>{{ title }}</h1>
      <p class="article__summary">{{ summary }}</p>
      <div class="article__meta">
        <span>By {{ site.name }}</span>
        <span>{{ icon('calendar') }}<time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time></span>
        <span>{{ icon('clock') }}{{ readTime or (content | readingTime) }}</span>
      </div>
    </header>
    <img class="article__cover" src="{{ coverImage }}" alt="" width="1200" height="675">
    <div class="article__layout">
      {% set toc = content | tableOfContents %}
      {% if toc %}<aside class="toc"><strong>In this article</strong>{{ toc | safe }}</aside>{% endif %}
      <div class="prose">{{ content | safe }}</div>
    </div>
    <nav class="article-share" aria-label="Share this article">
      <strong>Share this insight</strong>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ (site.siteUrl + page.url) | urlencode }}" target="_blank" rel="noopener noreferrer">LinkedIn {{ icon('share') }}</a>
      <a href="mailto:?subject={{ title | urlencode }}&body={{ (site.siteUrl + page.url) | urlencode }}">Email {{ icon('share') }}</a>
    </nav>
    <nav class="article-nav" aria-label="Article navigation">
      {% set previousPost = collections.publishedPosts | getPreviousCollectionItem %}{% set nextPost = collections.publishedPosts | getNextCollectionItem %}
      {% if previousPost %}<a href="{{ previousPost.url }}"><span>Previous</span>{{ previousPost.data.title }}</a>{% endif %}
      {% if nextPost %}<a href="{{ nextPost.url }}"><span>Next</span>{{ nextPost.data.title }}</a>{% endif %}
    </nav>
    <section class="related-articles">
      <div class="section-heading"><p class="eyebrow">Continue Reading</p><h2>Related insights</h2></div>
      <div class="related-articles__grid">
        {% for post in collections.publishedPosts | relatedPosts(page.url, 2) %}
          <a href="{{ post.url }}"><span>{{ post.data.category }}</span><strong>{{ post.data.title }}</strong><small>{{ post.data.readTime or (post.content | readingTime) }}</small></a>
        {% endfor %}
      </div>
    </section>
  </div>
</article>
