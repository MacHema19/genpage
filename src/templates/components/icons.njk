{# Shared accessible decorative icon macro. #}
{% macro icon(name) %}
<svg class="icon icon--{{ name }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {% if name == "calendar" %}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>
  {% elif name == "globe" %}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>
  {% elif name == "building" %}<path d="M4 21V5l8-3v19M12 8h8v13M8 7v2M8 12v2M8 17v2M16 12v2M16 17v2M2 21h20"/>
  {% elif name == "education" %}<path d="M3 9l9-5 9 5-9 5-9-5zM7 12v5c3 2 7 2 10 0v-5"/>
  {% elif name == "layers" %}<path d="M12 3L3 8l9 5 9-5-9-5zM5 12l7 4 7-4M5 16l7 4 7-4"/>
  {% elif name == "shield" %}<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3zM9 12l2 2 4-4"/>
  {% elif name == "operate" %}<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>
  {% elif name == "transform" %}<path d="M4 7h11l-3-3M20 17H9l3 3M17 4v7h-7M7 20v-7h7"/>
  {% elif name == "arrow" %}<path d="M5 12h14M14 7l5 5-5 5"/>
  {% elif name == "download" %}<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>
  {% elif name == "external" %}<path d="M14 4h6v6M20 4l-9 9M18 13v6H5V6h6"/>
  {% else %}<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>{% endif %}
</svg>
{% endmacro %}
